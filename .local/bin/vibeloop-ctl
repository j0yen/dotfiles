#!/usr/bin/env bash
# vibeloop-ctl — drive the mcphost-buildloop (/vibeloop on RedBaron) from any fleet node.
#
# State of record is the j0yen/PRDs repo (~/Documents/PRDs, dir vibeloop/): goal, STOP,
# state.json, ledger.md. Cycles run only on RedBaron (cargo lives there) via
# claude-vibeloop.timer. This tool edits state through git and talks to RedBaron over ssh.
#
#   vibeloop-ctl status              queue depth, state.json, ledger tail, STOP, timer/cycle state
#   vibeloop-ctl start               run one cycle now on RedBaron (does not wait)
#   vibeloop-ctl log [-f]            tail the cycle log on RedBaron
#   vibeloop-ctl ledger [N]          last N ledger lines (default 10), after a pull
#   vibeloop-ctl goal "<text>"       replace the standing goal (intent.md), push, RedBaron pulls
#   vibeloop-ctl stop "<reason>"     write STOP (halts at next cycle), push, mirror to RedBaron
#   vibeloop-ctl resume              remove STOP, push, mirror to RedBaron
#   vibeloop-ctl queue               list build-queue PRDs with Status
#   vibeloop-ctl park <slug>|unpark <slug>   move a PRD between parked/ and build-queue/, push
#   vibeloop-ctl timer on|off        enable/disable claude-vibeloop.timer on RedBaron
#   vibeloop-ctl watch               subscribe to wm.vibeloop.> on NATS (cycle verdicts)
#   vibeloop-ctl sync                pull PRDs here and on RedBaron
#   vibeloop-ctl measure [N]         truth-tier runs: last N measure-ledger lines (with proxy/cleanup fields when present), LATEST measure.json summary, last proxy result, timer state
#   vibeloop-ctl questions [N]       what recent cycles flagged for a human (ledger notes + "needs human" log lines)
#   vibeloop-ctl answer "<text>"     record an operator answer/decision in the project profile (read by every dream cycle), push
#   vibeloop-ctl cost [days]         per-day spend totals + top 5 PRDs by cost, from vibeloop/cost-ledger.jsonl (default 7d)
#   vibeloop-ctl archive-cost <slug> sum a PRD's cost-ledger share, write "- Cost: $x.xx over n cycles" into its archived frontmatter
#   vibeloop-ctl digest [date]       pull, then print vibeloop/digest/<date|today>.md (PRD-vibeloop-daily-digest)
#   vibeloop-ctl digest --today      generate today's page fresh (vibeloop-digest.sh --no-commit) and print it, no commit
#   vibeloop-ctl claim "<note>" [--for 2h]   record an operator claim (host/user/note/expiry) in
#                                     vibeloop/operator.json, commit; default 2h, max 12h expiry
#   vibeloop-ctl release             remove the current claim, commit
#   vibeloop-ctl who                 print the current claim and the last 10 operator-attributed commits
#   vibeloop-ctl operator-summary    print "operator=<host|none> controls=<8-char digest>" for the
#                                     tick to append to its ledger line (read-side primitive; see below)
#
# PRD-vibeloop-operator-claim: two operators, one hand on the wheel at a time. `claim`/`release`
# record who is driving; control commands (goal/stop/resume/answer/park/unpark/timer) refuse,
# without --force, when another host holds an unexpired claim; read commands never check it.
# `--force` on any control command overrides and appends forced-by=<host> to the commit message.
set -uo pipefail
HOST="${VIBELOOP_HOST:-redbaron}"
PRD_DIR="${DREAM_PRD_DIR:-$HOME/Documents/PRDs}"
LOOP="$PRD_DIR/vibeloop"
CL="$LOOP/cost-ledger.jsonl"
CLAIM="$LOOP/operator.json"
NATS_URL="${NATS_URL:-nats://127.0.0.1:4222}"
here() { [ "$(hostname)" = "RedBaron" ]; }
rb() { if here; then bash -lc "$*"; else ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "export PATH=\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH; $*"; fi; }
pull() { git -C "$PRD_DIR" pull -q --ff-only 2>/dev/null || echo "warn: pull failed (offline or diverged)" >&2; }
push() { # $1 message, rest = paths
  local msg="$1"; shift
  git -C "$PRD_DIR" add -A -- "$@" && git -C "$PRD_DIR" commit -q -m "$msg" -- "$@" 2>/dev/null || true
  git -C "$PRD_DIR" push -q 2>/dev/null || echo "warn: push failed" >&2
  here || rb "git -C ~/Documents/PRDs pull -q --ff-only" 2>/dev/null || echo "warn: RedBaron pull failed (fleet-sync will catch up hourly)" >&2
}
# PRD-vibeloop-operator-claim: read vibeloop/operator.json into CLAIM_* globals.
# CLAIM_EXISTS=1 iff the file exists at all; CLAIM_ACTIVE=1 iff it also hasn't expired.
claim_eval() {
  CLAIM_EXISTS=0 CLAIM_ACTIVE=0 CLAIM_HOST="" CLAIM_USER="" CLAIM_NOTE="" CLAIM_EXP=""
  [ -f "$CLAIM" ] || return 0
  CLAIM_EXISTS=1
  eval "$(python3 - "$CLAIM" <<'PY'
import json,sys,time,calendar,shlex
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    d={}
host=d.get("host",""); user=d.get("user",""); note=d.get("note",""); exp=d.get("expires_at","")
active=0
try:
    t=calendar.timegm(time.strptime(exp,"%Y-%m-%dT%H:%M:%SZ"))
    active=1 if t>time.time() else 0
except Exception:
    active=0
print(f"CLAIM_HOST={shlex.quote(host)}")
print(f"CLAIM_USER={shlex.quote(user)}")
print(f"CLAIM_NOTE={shlex.quote(note)}")
print(f"CLAIM_EXP={shlex.quote(exp)}")
print(f"CLAIM_ACTIVE={active}")
PY
)"
}
# Gate a control command on the current claim. Sets FORCE_SUFFIX ("" or " forced-by=<host>")
# for the caller to append to its commit message. Exits 3 (no state change) when blocked.
claim_gate() {
  claim_eval
  local host; host="$(hostname)"
  FORCE_SUFFIX=""
  if [ "$CLAIM_EXISTS" = 1 ] && [ "$CLAIM_ACTIVE" = 1 ] && [ "$CLAIM_HOST" != "$host" ]; then
    if [ "$FORCE" = 1 ]; then
      FORCE_SUFFIX=" forced-by=$host"
      echo "warning: overriding claim by $CLAIM_HOST ($CLAIM_USER) until $CLAIM_EXP: $CLAIM_NOTE (--force)" >&2
      return 0
    fi
    echo "claimed by $CLAIM_HOST ($CLAIM_USER) until $CLAIM_EXP: $CLAIM_NOTE; use --force to override" >&2
    exit 3
  fi
}
queue_count() { grep -ls '^- Status: queued' "$PRD_DIR"/build-queue/*.md 2>/dev/null | wc -l | tr -d ' '; }
# PRD-vibeloop-cost-budget: sum cost-ledger.jsonl by kind over a rolling window (seconds).
cost_window() { # $1=window_secs -> "total cycle dream measure probe proxy" (USD, 4dp)
  python3 - "$CL" "$1" <<'PY'
import json,sys,time,calendar
path,win=sys.argv[1],float(sys.argv[2])
now=time.time(); tot={}
try:
    for line in open(path):
        line=line.strip()
        if not line: continue
        try: r=json.loads(line)
        except Exception: continue
        try: t=calendar.timegm(time.strptime(r.get("ts",""),"%Y-%m-%dT%H:%M:%SZ"))
        except Exception: continue
        if now - t > win: continue
        k=r.get("kind","?"); tot[k]=tot.get(k,0.0)+float(r.get("usd") or 0)
except FileNotFoundError:
    pass
total=sum(tot.values())
print(f'{total:.4f} {tot.get("cycle",0):.4f} {tot.get("dream",0):.4f} {tot.get("measure",0):.4f} {tot.get("probe",0):.4f} {tot.get("proxy",0):.4f}')
PY
}
cmd="${1:-status}"; shift || true
# PRD-vibeloop-operator-claim: --force is a global flag on any control command; strip it here
# so per-command arg parsing ($1, $*, etc.) below never sees it.
FORCE=0; ARGS=()
for a in "$@"; do [ "$a" = "--force" ] && FORCE=1 || ARGS+=("$a"); done
set -- "${ARGS[@]}"
case "$cmd" in
  status)
    pull
    claim_eval
    if [ "$CLAIM_EXISTS" = 1 ] && [ "$CLAIM_ACTIVE" = 1 ]; then
      echo "claim: $CLAIM_HOST ($CLAIM_USER) until $CLAIM_EXP — $CLAIM_NOTE"
    elif [ "$CLAIM_EXISTS" = 1 ]; then
      echo "claim: none (expired $CLAIM_EXP — was $CLAIM_HOST: $CLAIM_NOTE)"
    else
      echo "claim: none"
    fi
    echo "host: $HOST   prd_dir: $PRD_DIR ($(git -C "$PRD_DIR" rev-parse --short HEAD 2>/dev/null))"
    echo "queue: $(queue_count) queued in build-queue/"
    [ -f "$LOOP/state.json" ] && echo "state: $(tr -d '\n ' < "$LOOP/state.json")"
    if [ -f "$LOOP/STOP" ]; then echo "STOP: present — $(head -1 "$LOOP/STOP")"; else echo "STOP: absent (running)"; fi
    [ -f "$LOOP/intent.md" ] && echo "goal: $(head -c 120 "$LOOP/intent.md" | tr '\n' ' ')…"
    since=$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-24H +%Y-%m-%dT%H:%M:%SZ)
    echo "last 24h: $(awk -v s="$since" '$1 > s' "$LOOP/ledger.md" 2>/dev/null | wc -l | tr -d ' ') cycles, $(awk -v s="$since" '$1 > s' "$LOOP/ledger.md" 2>/dev/null | grep -c 'dreamed=\[PRD') dreams, $(awk -v s="$since" '$1 > s' "$LOOP/ledger.md" 2>/dev/null | grep -c 'verdict=PROGRESS') progress, $(awk -v s="$since" '$1 > s' "$LOOP/ledger.md" 2>/dev/null | grep -cE 'verdict=(ABORTED|HALTED)') aborted (caps live in RedBaron ~/.config/vibeloop/limits; 3 consecutive failures write STOP)"
    max_day=$(rb "grep -m1 '^MAX_COST_USD_PER_DAY=' ~/.config/vibeloop/limits 2>/dev/null | cut -d= -f2 | cut -d' ' -f1"); max_day="${max_day:-60}"
    read -r sum24 cyc24 dream24 meas24 probe24 proxy24 <<< "$(cost_window 86400)"
    printf 'spend 24h: $%.2f of $%s (cycles $%.2f, dream $%.2f, measure $%.2f, probe $%.2f)\n' "$sum24" "$max_day" "$cyc24" "$dream24" "$meas24" "$probe24"
    echo "ledger (last 3):"; tail -n 3 "$LOOP/ledger.md" 2>/dev/null | cut -c1-220 | sed 's/^/  /'
    rb "awk -v s=\"\$(date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ)\" '\$1 > s && /cycle: cost_usd=/ {n++; split(\$3,a,\"=\"); c+=a[2]} END {printf \"cost (24h, API-equivalent): \$%.2f over %d cycles\\n\", c, n}' ~/brain/journal/vibeloop-auto.log 2>/dev/null"
    echo "RedBaron:"; rb "systemctl --user is-enabled claude-vibeloop.timer 2>/dev/null | sed 's/^/  timer: /'; systemctl --user is-active claude-vibeloop-work.service 2>/dev/null | sed 's/^/  cycle: /'; systemctl --user list-timers 2>/dev/null | grep claude-vibeloop | awk '{print \"  next: \" \$1\" \"\$2\" \"\$3\" \"\$4}'; grep -E 'launcher|cycle: (ok|failed|ABORTED|quota)' ~/brain/journal/vibeloop-auto.log 2>/dev/null | tail -n 3 | cut -c1-150 | sed 's/^/  log: /'" ;;
  start)  rb "systemctl --user start claude-vibeloop.service" && echo "cycle launched on $HOST (tail with: vibeloop-ctl log -f)" ;;
  log)    if [ "${1:-}" = "-f" ]; then rb "tail -n 20 -f ~/brain/journal/vibeloop-auto.log"; else rb "tail -n ${1:-40} ~/brain/journal/vibeloop-auto.log"; fi ;;
  ledger) pull; tail -n "${1:-10}" "$LOOP/ledger.md" ;;
  goal)   [ -n "${1:-}" ] || { echo "usage: vibeloop-ctl goal \"<text>\" [--force]" >&2; exit 2; }
          pull; claim_gate; mkdir -p "$LOOP"; printf '%s\n' "$*" > "$LOOP/intent.md"; push "vibeloop: goal — ${1:0:60}${FORCE_SUFFIX}" vibeloop/intent.md; echo "goal set" ;;
  stop)   pull; claim_gate; mkdir -p "$LOOP"; printf 'STOP: %s\nSet %s from %s. Resume: vibeloop-ctl resume\n' "${*:-operator stop}" "$(date -u +%FT%TZ)" "$(hostname)" > "$LOOP/STOP"
          push "vibeloop: STOP — ${*:-operator stop}${FORCE_SUFFIX}" vibeloop/STOP; here || rb "cp -n ~/Documents/PRDs/vibeloop/STOP ~/Documents/PRDs/vibeloop/STOP 2>/dev/null; true"; echo "STOP written; the next cycle halts" ;;
  resume) pull; claim_gate; rm -f "$LOOP/STOP"; push "vibeloop: resume${FORCE_SUFFIX}" vibeloop/STOP; echo "STOP removed" ;;
  claim)  [ -n "${1:-}" ] || { echo 'usage: vibeloop-ctl claim "<note>" [--for 2h]' >&2; exit 2; }
          pull; mkdir -p "$LOOP"; note="$1"; shift || true
          hours="2"; [ "${1:-}" = "--for" ] && hours="${2:-2h}"
          python3 - "$CLAIM" "$(hostname)" "${USER:-$(id -un)}" "$note" "$hours" <<'PY'
import json,sys,datetime
path,host,user,note,hours=sys.argv[1:6]
try: h=float(hours.rstrip('hH'))
except Exception: h=2.0
if h<=0: h=2.0
if h>12: h=12.0
now=datetime.datetime.now(datetime.UTC)
exp=now+datetime.timedelta(hours=h)
d={"host":host,"user":user,"session_hint":f"{host}-{now.strftime('%H%M%S')}","note":note,
   "claimed_at":now.strftime("%Y-%m-%dT%H:%M:%SZ"),"expires_at":exp.strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump(d, open(path,"w"), indent=2); open(path,"a").write("\n")
PY
          push "vibeloop: claim by $(hostname) — ${note:0:60}" vibeloop/operator.json
          claim_eval; echo "claimed by $CLAIM_HOST until $CLAIM_EXP: $CLAIM_NOTE" ;;
  release) pull
          if [ -f "$CLAIM" ]; then rm -f "$CLAIM"; push "vibeloop: release claim by $(hostname)" vibeloop/operator.json; echo "claim released"
          else echo "no claim to release"; fi ;;
  who)    pull; claim_eval
          if [ "$CLAIM_EXISTS" = 1 ] && [ "$CLAIM_ACTIVE" = 1 ]; then echo "claim: $CLAIM_HOST ($CLAIM_USER) until $CLAIM_EXP — $CLAIM_NOTE"
          elif [ "$CLAIM_EXISTS" = 1 ]; then echo "claim: none (expired $CLAIM_EXP — was $CLAIM_HOST: $CLAIM_NOTE)"
          else echo "claim: none"; fi
          echo "last 10 operator-attributed commits:"
          git -C "$PRD_DIR" log --oneline -n 10 --extended-regexp \
            --grep='^vibeloop: (claim by|release claim by|goal|STOP|resume|operator answer|park |unpark )' \
            | sed 's/^/  /' ;;
  queue)  pull; for f in "$PRD_DIR"/build-queue/PRD-*.md; do printf '%-45s %s\n' "$(basename "$f")" "$(grep -m1 -oE '^- Status: [a-z]+' "$f" | cut -d' ' -f3)"; done ;;
  park)   pull; claim_gate; git -C "$PRD_DIR" mv "build-queue/PRD-$1.md" "parked/PRD-$1.md" && push "vibeloop: park $1${FORCE_SUFFIX}" build-queue parked ;;
  unpark) pull; claim_gate; git -C "$PRD_DIR" mv "parked/PRD-$1.md" "build-queue/PRD-$1.md" && push "vibeloop: unpark $1${FORCE_SUFFIX}" build-queue parked ;;
  timer)  pull; claim_gate
          case "${1:-}" in on) rb "systemctl --user enable --now claude-vibeloop.timer";; off) rb "systemctl --user disable --now claude-vibeloop.timer";; *) echo "usage: vibeloop-ctl timer on|off" >&2; exit 2;; esac
          [ -n "${FORCE_SUFFIX:-}" ] && echo "note: timer has no commit to attribute; override was logged to stderr above" ;;
  watch)  exec nats --server "$NATS_URL" sub 'wm.vibeloop.>' ;;
  sync)   pull; here || rb "git -C ~/Documents/PRDs pull -q --ff-only"; echo synced ;;
  measure)
    pull; n="${1:-5}"; ML="$LOOP/measure-ledger.md"; EVD="$PRD_DIR/evidence/mcp-host/measure"
    echo "== measure ledger (last $n) =="; tail -n "$n" "$ML" 2>/dev/null | cut -c1-240 | sed 's/^/  /'; [ -s "$ML" ] || echo "  (no runs yet)"
    # PRD-mcphost-measure-guards req 5/AC7: a separate line for the last proxy-gate
    # result (version, k/n, cost) — the per-run lines above already carry proxy=
    # and cleanup= fields inline (or don't, for older lines; Migration note).
    proxy_line=$(grep -E 'proxy=[0-9]+/[0-9]+' "$ML" 2>/dev/null | tail -n1)
    if [ -n "$proxy_line" ]; then
      pver=$(echo "$proxy_line" | grep -oE 'version=[^ ]+' | head -1 | cut -d= -f2)
      pkn=$(echo "$proxy_line" | grep -oE 'proxy=[0-9]+/[0-9]+' | head -1 | cut -d= -f2)
      pcost=$(python3 - "$CL" "$pver" <<'PY'
import json,sys
path,ver=sys.argv[1],sys.argv[2]
total=0.0
try:
    for line in open(path):
        line=line.strip()
        if not line: continue
        try: r=json.loads(line)
        except Exception: continue
        if r.get("kind")=="proxy" and r.get("ref")==ver: total+=float(r.get("usd") or 0)
except FileNotFoundError:
    pass
print(f"{total:.4f}")
PY
)
      echo "last proxy: version=$pver proxy=$pkn cost=\$$pcost"
    else
      echo "last proxy: (no proxy runs yet)"
    fi
    if [ -f "$EVD/LATEST" ]; then d="$EVD/$(cat "$EVD/LATEST")"; echo "== LATEST: $(cat "$EVD/LATEST") =="; python3 - "$d/measure.json" <<'PY2'
import json,sys
try: m=json.load(open(sys.argv[1]))
except Exception as e: print("  unreadable:",e); sys.exit()
print(f"  satisfaction={m.get('satisfaction')} wow_rate={m.get('wow_rate')} sessions={m.get('sessions')} failures={m.get('failures')}")
for seg,v in (m.get('by_segment') or {}).items(): print(f"  {seg:26s} sat={v.get('satisfaction')} wow={v.get('wow_rate')} n={v.get('n')}")
PY2
    fi
    echo "== RedBaron measure job =="
    rb "systemctl --user is-enabled claude-vibeloop-measure.timer 2>/dev/null" | sed 's/^/  timer: /'
    rb "systemctl --user is-active claude-vibeloop-measure.service 2>/dev/null" | sed 's/^/  run: /'
    rb "cat ~/.config/vibeloop/calibration-remaining 2>/dev/null" | sed 's/^/  calibration runs left: /'
    rb "tail -n 3 ~/brain/journal/vibeloop-measure.log 2>/dev/null" | cut -c1-160 | sed 's/^/  log: /'
    curl -s --max-time 6 https://178-105-64-66.sslip.io/healthz | sed 's/^/  hub: /' ;;
  questions)
    pull; n="${1:-5}"
    echo "== ledger notes (last $n cycles) =="; tail -n "$n" "$LOOP/ledger.md" 2>/dev/null | grep -oE 'cycle=[0-9]+|blocked=\[[^]]*\]|note="[^"]*"' | grep -vE 'blocked=\[\]' | cut -c1-300 | sed 's/^/  /'
    echo "== flagged for a human (RedBaron cycle log) =="; rb "grep -nE 'needs (a )?human|worth your attention|Needs your action|only you can|Joe to|human .*(decide|provision|confirm)' ~/brain/journal/vibeloop-auto.log 2>/dev/null | tail -n 12 | cut -c1-260" | sed 's/^/  /'
    echo "== open questions (project profile / vision) =="; grep -hA12 '^## Open questions' "$PRD_DIR"/visions/mcp-host.md 2>/dev/null | grep -E '^\|' | grep -v -- '---' | tail -n +2 | cut -c1-160 | sed 's/^/  /'
    echo; echo "answer with: vibeloop-ctl answer \"<decision>\"   (lands in projects/mcp-host.md; dream reads it) — or vibeloop-ctl goal / park / stop" ;;
  answer) [ -n "${1:-}" ] || { echo "usage: vibeloop-ctl answer \"<text>\" [--force]" >&2; exit 2; }
    pull; claim_gate; prof="$PRD_DIR/projects/mcp-host.md"
    grep -q '^## Operator answers' "$prof" || printf '\n## Operator answers (append-only; dream reads these before every run)\n' >> "$prof"
    printf -- '- %s (%s): %s\n' "$(date -u +%Y-%m-%d)" "$(hostname)" "$*" >> "$prof"
    push "vibeloop: operator answer — ${1:0:60}${FORCE_SUFFIX}" projects/mcp-host.md; echo "recorded in projects/mcp-host.md" ;;
  cost)
    pull
    if [ "${1:-}" = "--import-log" ]; then echo "cost --import-log: not implemented this ship (see PRD-vibeloop-cost-budget Migration note); import manually if needed" >&2; exit 1; fi
    days="${1:-7}"
    python3 - "$CL" "$days" <<'PY'
import json,sys,time,calendar,collections
path,days=sys.argv[1],int(sys.argv[2])
now=time.time(); cutoff=now-days*86400
byday=collections.defaultdict(float); byprd=collections.defaultdict(float)
try:
    for line in open(path):
        line=line.strip()
        if not line: continue
        try: r=json.loads(line)
        except Exception: continue
        try: t=calendar.timegm(time.strptime(r.get("ts",""),"%Y-%m-%dT%H:%M:%SZ"))
        except Exception: continue
        if t < cutoff: continue
        usd=float(r.get("usd") or 0)
        day=r.get("ts","")[:10]
        byday[day]+=usd
        refs=r.get("ref")
        if isinstance(refs,str): refs=[refs]
        refs=[x for x in (refs or []) if isinstance(x,str) and x.startswith("PRD-")]
        if refs:
            share=usd/len(refs)
            for p in refs: byprd[p]+=share
except FileNotFoundError:
    print("(no cost-ledger.jsonl yet)"); sys.exit()
print(f"== per-day totals (last {days}d) ==")
for day in sorted(byday): print(f"  {day}  ${byday[day]:.2f}")
print("== top 5 PRDs by cost ==")
for p,usd in sorted(byprd.items(), key=lambda kv:-kv[1])[:5]:
    print(f"  {p:50s} ${usd:.2f}")
if not byprd: print("  (no PRD-attributed lines yet)")
PY
    ;;
  archive-cost)
    [ -n "${1:-}" ] || { echo "usage: vibeloop-ctl archive-cost <slug>" >&2; exit 2; }
    pull; slug="$1"; f="$PRD_DIR/built-prds/PRD-$slug.md"
    [ -f "$f" ] || { echo "not found: $f" >&2; exit 1; }
    read -r usd n <<< "$(python3 - "$CL" "PRD-$slug.md" <<'PY'
import json,sys
path,ref=sys.argv[1],sys.argv[2]
usd=0.0; n=0
try:
    for line in open(path):
        line=line.strip()
        if not line: continue
        try: r=json.loads(line)
        except Exception: continue
        refs=r.get("ref")
        if isinstance(refs,str): refs=[refs]
        refs=refs or []
        if ref in refs:
            usd += float(r.get("usd") or 0)/len(refs)
            n += 1
except FileNotFoundError:
    pass
print(f"{usd:.4f} {n}")
PY
)"
    if [ "$n" = "0" ]; then echo "no cost-ledger lines reference PRD-$slug.md yet" >&2; exit 1; fi
    cost_line=$(printf -- '- Cost: $%.2f over %s cycles' "$usd" "$n")
    if grep -q '^- Cost:' "$f"; then
      python3 -c "import sys,re; p=sys.argv[1]; c=sys.argv[2]; s=open(p).read(); s=re.sub(r'^- Cost:.*$', c, s, count=1, flags=re.M); open(p,'w').write(s)" "$f" "$cost_line"
    else
      python3 -c "import sys; p=sys.argv[1]; c=sys.argv[2]; lines=open(p).read().splitlines(True); out=[]; done=False
for l in lines:
    out.append(l)
    if not done and l.startswith('- Receipts:'):
        out.append(c+chr(10)); done=True
if not done:
    for i,l in enumerate(lines):
        if l.startswith('- Status:'):
            out=lines[:i+1]+[c+chr(10)]+lines[i+1:]; done=True; break
if not done:
    out.insert(1, c+chr(10))
open(p,'w').writelines(out)" "$f" "$cost_line"
    fi
    push "vibeloop: archive-cost $slug — $cost_line" "built-prds/PRD-$slug.md"
    echo "$cost_line -> $f" ;;
  digest)
    if [ "${1:-}" = "--today" ]; then
      command -v vibeloop-digest.sh >/dev/null 2>&1 || { echo "vibeloop-digest.sh not on PATH" >&2; exit 1; }
      pull; DREAM_PRD_DIR="$PRD_DIR" vibeloop-digest.sh "$(date -u +%F)" --no-commit >/dev/null && cat "$LOOP/digest/$(date -u +%F).md"
    else
      pull; d="${1:-$(date -u +%F)}"; f="$LOOP/digest/$d.md"
      [ -f "$f" ] || { echo "no digest for $d yet ($f) — try: vibeloop-ctl digest --today" >&2; exit 1; }
      cat "$f"
    fi ;;
  operator-summary)
    # PRD-vibeloop-operator-claim req 4/5: a primitive the RedBaron tick can call at cycle start
    # and append verbatim to the ledger line — `operator=<host|none> controls=<8-char digest>`.
    # Not yet wired into the tick itself (that's ~/wintermute/vicecode-kit's SKILL.md, a
    # different repo than this PRD's build_into: dotfiles); this subcommand is the ready-made
    # read-side so wiring it in is a one-line addition there.
    pull; claim_eval
    op="none"; [ "$CLAIM_EXISTS" = 1 ] && [ "$CLAIM_ACTIVE" = 1 ] && op="$CLAIM_HOST"
    digest=$( { cat "$HOME/.config/vibeloop/limits" 2>/dev/null; printf '%s' "${VIBELOOP_CAP_SECS:-}${VIBELOOP_WATCHDOG_SECS:-}"; } | sha256sum | cut -c1-8 )
    echo "operator=$op controls=$digest" ;;
  *)      awk '/^set -uo pipefail/{exit} NR>=2{print}' "$0"; exit 2 ;;
esac
