#!/usr/bin/env bash
# token-ledger — one row per UTC day of weighted Claude token usage across
# the fleet (carbon, redbaron, ryzen7), bucketed by each record's OWN
# timestamp, never by run time. PRD-token-ledger-day-buckets.
#
# Weighted = in + 1.25*cache_write + 0.1*cache_read + 5*out (CLAUDE.md
# formula, 2026-09-11; unchanged by this PRD). Dedup key is message.id,
# keeping the record with the latest timestamp (its final cumulative
# usage) — a message can appear on more than one JSONL line as usage
# accumulates while it streams.
#
# Usage:
#   token-ledger [--since ISO] [--until ISO]  upsert day rows for [since,until)
#   token-ledger --day YYYY-MM-DD             recompute exactly one day
#   token-ledger --check                      validate ledger.tsv + message
#                                              index, non-zero exit on
#                                              corruption (P1)
#   token-ledger --emit-local-records --since ISO
#       internal: print this host's own raw (non-deduped) records as
#       NDJSON. The exact same binary runs this mode over ssh on each
#       remote fleet host — that's how the orchestrator on one node reads
#       another node's data without duplicating the extraction logic.
#       Every record carries `role` (what the tokens bought), derived once
#       per JSONL FILE from the file's path, the seat table and the first
#       user text — nothing but the JSONL files and $SEATS_TABLE is read:
#         inner          project dir matches wm-build-wt- or wm-build/wt/
#         verifier|coder|runner|review|scout
#                        file under <sid>/subagents/, by first user text:
#                        ^(VERIF|RE-VERIFY) -> verifier (VERIF covers VERIFY, VERIFIED, verifier);
#                        coder|implement|FIX PASS|DELTA|hand PR|binding spec|
#                        Read your full spec -> coder; ^(RUNNER|run ) -> runner;
#                        review|re-grade|regrade|verdict|DECISION -> review;
#                        else scout (all case-insensitive)
#         seat:<name>    top-level file whose SID is column 3 of $SEATS_TABLE
#         seat:aide      top-level file whose SID is a line of $AIDE_SIDS_FILE; a line `<sid> <lane> since=<epoch>` with a lane other than main tags it
#                        seat:aide:<lane> for rows stamped at/after since (earlier rows keep their no-sids-line role; aide-lanes 10-27)
#                        (TOKEN_LEDGER_AIDE_SIDS, default ~/.cache/fleet-dash/aide-sids;
#                        appended by .claude/hooks/aide-inbox.sh at every aide
#                        prompt; a seats.tsv row for the same SID wins)
#         coder|verifier|runner|interactive
#                        other top-level file: same text rules, else interactive
#
# State lives under $TOKEN_LEDGER_STATE_DIR (default ~/.cache/token-ledger):
#   ledger.tsv          one row per UTC day: date, per_model, weighted,
#                        status, complete, hosts, missing, generated, then
#                        (appended; older readers ignore them) split,
#                        per_host, compactions, per_role (role=weighted;...)
#   message-index.tsv   id -> day; an internal companion file that lets
#                        --check catch a message double-counted across two
#                        days without re-scanning every JSONL on disk
#   today-summary.txt   the line the SessionStart banner hook cats, plus an
#                        `ALARM build_share ...` second line when today's
#                        build_share (BUILD_ROLES_RE weighted / (total -
#                        EXCLUDE_ROLES_RE weighted)) is < 50 %;
#                        building = coder, inner, seat:ctl, seat:rb, seat:r7,
#                        seat:aide (Joe 10-23 12:2x PM "controller, rb and r7
#                        are part of the wm-build now", "aide is also part of
#                        wm-build"); their scouts/runners/verifiers/reviews
#                        and unknown = management; `interactive` (Joe's own
#                        plain sessions) is excluded from both sides of the
#                        share (Joe 10-23 1:0x PM "exclude it") and shown as
#                        `interactive NM excluded` in the summary
#                        and that denominator is > 50M
#   build-share.json    {date, build_share, build_weighted, total_weighted
#                        (full, interactive included), excluded_weighted,
#                        share_denominator, excluded_roles_re,
#                        per_role:{role:weighted}} for today (build_share is a
#                        percent with one decimal, null when per_role is
#                        unknown); for the fleet dashboard to pick up. Also
#                        tooling_share (fraction, 4 dp; null when the window
#                        has no tokens), tooling_weighted, tooling_window_days
#                        (7), tooling_budget (0.05): tooling = sessions whose
#                        transcript cwd is a git checkout with origin
#                        j0yen/{swarm-decide,dotfiles,wm-build}; unattributed
#                        sessions are NOT tooling. today-summary.txt gets
#                        `ALARM tooling_share=X.X % >= 80 % of 5 % budget`
#                        at >= 4 %. Sidecar tooling-daily.tsv (date, weighted).
#
# Testability knobs (env vars; all optional, all default to the real
# thing): TOKEN_LEDGER_STATE_DIR, TOKEN_LEDGER_JSONL_ROOT,
# TOKEN_LEDGER_HOSTS ("carbon redbaron ryzen7" default),
# TOKEN_LEDGER_LOCAL_HOST (default `hostname -s`), TOKEN_LEDGER_SSH_TIMEOUT
# (default 30s), TOKEN_LEDGER_NOW (fakes "now" for default-window math and
# the summary's yesterday/today split), SEATS_TABLE (seat table whose col 3
# is the seat's SID; default ~/.claude/state/seats.tsv), TOKEN_BUDGET_WEIGHTED (unset or 0
# => "budget off" status, per CLAUDE.md 2026-09-12 removal of the daily cap).
set -uo pipefail

STATE_DIR="${TOKEN_LEDGER_STATE_DIR:-$HOME/.cache/token-ledger}"
JSONL_ROOT="${TOKEN_LEDGER_JSONL_ROOT:-$HOME/.claude/projects}"
HOSTS_STR="${TOKEN_LEDGER_HOSTS:-carbon redbaron ryzen7}"
LOCAL_HOST="${TOKEN_LEDGER_LOCAL_HOST:-$(hostname -s 2>/dev/null || hostname)}"
SSH_TIMEOUT="${TOKEN_LEDGER_SSH_TIMEOUT:-30}"
BUDGET="${TOKEN_BUDGET_WEIGHTED:-0}"
NOW="${TOKEN_LEDGER_NOW:-$(date -u +%FT%TZ)}"

LEDGER_TSV="$STATE_DIR/ledger.tsv"
INDEX_TSV="$STATE_DIR/message-index.tsv"
SUMMARY_TXT="$STATE_DIR/today-summary.txt"
BUILD_SHARE_JSON="$STATE_DIR/build-share.json"
AIDE_SIDS_FILE="${TOKEN_LEDGER_AIDE_SIDS:-${FLEET_DASH_DIR:-$HOME/.cache/fleet-dash}/aide-sids}"
# roles whose weighted tokens count as building (ERE, matched whole by the awk below); everything else is management
BUILD_ROLES_RE='^(coder|inner|seat:(ctl|rb|r7|aide(:[A-Za-z0-9._-]+)?))$'
BUILD_ROLES_LABEL='coder+inner+seats'
# roles left out of both sides of build_share (Joe 10-23 "exclude it"); their tokens are shown separately
EXCLUDE_ROLES_RE='^interactive$'
SEATS_TABLE="${SEATS_TABLE:-$HOME/.claude/state/seats.tsv}"
LEDGER_HEADER_V1=$'date\tper_model\tweighted\tstatus\tcomplete\thosts\tmissing\tgenerated'
LEDGER_HEADER_V2=$LEDGER_HEADER_V1$'\tsplit\tper_host\tcompactions'
LEDGER_HEADER=$LEDGER_HEADER_V2$'\tper_role'
LEDGER_NCOLS=12

# jq filter: one assistant/usage record -> {id, ts, model, in, cw, cr, out}.
JQ_EXTRACT='select(.type=="assistant" and .message.usage != null and .message.id != null and .timestamp != null)
  | {id: .message.id, ts: .timestamp, model: (.message.model // "unknown"),
     in: (.message.usage.input_tokens // 0),
     cw: (.message.usage.cache_creation_input_tokens // 0),
     cr: (.message.usage.cache_read_input_tokens // 0),
     out: (.message.usage.output_tokens // 0)}'

# jq filter: first user text of a transcript (stdin = its first lines) ->
# one whitespace-collapsed line. Skips harness-injected text (command echoes,
# system reminders, task notifications); content is a string or an array
# whose first real .type=="text" element counts.
JQ_FIRST_TEXT='select(.type=="user")
  | ((.message.content // "")
     | if type=="string" then [.]
       elif type=="array" then [.[] | select(type=="object" and .type=="text") | .text]
       else [] end)
  | map(select(type=="string"
       and (startswith("<command-name") or startswith("<local-command")
            or startswith("<system-reminder") or startswith("<task-notification")) | not)
       | gsub("\\s+"; " ") | sub("^ "; "") | select(length > 0))
  | .[0] // empty | .[0:4000]'

# jq filter: one compaction-summary line -> {kind:"compact", id:uuid, ts}.
# Marker (confirmed on real transcripts): a type=="user" line carrying
# isCompactSummary:true AND message.content (string) starting "This session
# is being continued from a previous conversation". Either one counts; a
# resumed session can copy a line into a second JSONL, so the central
# aggregation dedups on uuid.
JQ_COMPACT='select(.type=="user" and .uuid != null and .timestamp != null
    and (.isCompactSummary == true
         or (((.message.content // "")
              | if type=="string" then .
                elif type=="array" then ([.[] | select(type=="object" and .type=="text") | .text] | .[0] // "")
                else "" end)
             | startswith("This session is being continued from a previous conversation"))))
  | {kind: "compact", id: .uuid, ts: .timestamp}'

die() { printf 'token-ledger: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage: token-ledger [--since ISO] [--until ISO]
       token-ledger --day YYYY-MM-DD
       token-ledger --check
       token-ledger --emit-local-records --since ISO
EOF
}

# status_for WEIGHTED -> "budget off" | "OVER" | "UNDER <budget>"
status_for() {
  local w="$1"
  if [ -z "$BUDGET" ] || [ "$BUDGET" = "0" ]; then
    echo "budget off"
  elif [ "$w" -gt "$BUDGET" ]; then
    echo "OVER"
  else
    echo "UNDER $BUDGET"
  fi
}

# ---- role (per JSONL file; see header) -------------------------------------
declare -A SEAT_BY_SID=()
declare -A SINCE_BY_SID=()   # aide lane sids only: launch epoch from the aide-sids `since=` field (rows before it keep their prior role)
load_seats() {
  [ -r "$SEATS_TABLE" ] || return 0
  local s_seat s_sid _role _r
  while IFS=$'\t' read -r s_seat _role s_sid _r; do
    case "$s_seat" in ''|'#'*) continue ;; esac
    [ -n "$s_sid" ] && SEAT_BY_SID["$s_sid"]="$s_seat"
  done < "$SEATS_TABLE"
}
load_aide_sids() {
  [ -r "$AIDE_SIDS_FILE" ] || return 0
  # lines: `<sid>` (bare, = main) or `<sid> <lane> since=<epoch>` (aide-inbox.sh); a lane other than main tags the sid `aide:<lane>`
  local a_sid a_line a_lane a_since a_f2 a_f3 _rest
  while IFS= read -r a_line || [ -n "$a_line" ]; do
    read -r a_sid a_f2 a_f3 _rest <<<"$a_line"
    case "$a_sid" in ''|'#'*) continue ;; esac
    a_lane=main; a_since=0
    [[ "$a_f2" =~ ^[A-Za-z0-9_-]{1,32}$ ]] && a_lane="$a_f2"
    [[ "$a_f3" =~ ^since=([0-9]{1,12})$ ]] && a_since="${BASH_REMATCH[1]}"
    [ -n "${SEAT_BY_SID[$a_sid]:-}" ] && continue
    if [ "$a_lane" = main ]; then SEAT_BY_SID["$a_sid"]="aide"
    else SEAT_BY_SID["$a_sid"]="aide:$a_lane"; SINCE_BY_SID["$a_sid"]="$a_since"; fi
  done < "$AIDE_SIDS_FILE"
}

# role_from_text TEXT MODE(sub|top) -> role, or "" when no text rule fires
# on a top-level file (the caller maps that to interactive / scout).
role_from_text() {
  local t="$1" mode="$2" r=""
  shopt -s nocasematch
  if   [[ "$t" =~ ^(VERIF|RE-VERIFY) ]]; then r="verifier"
  elif [[ "$t" =~ (coder|implement|FIX\ PASS|DELTA|hand\ PR|binding\ spec|Read\ your\ full\ spec) ]]; then r="coder"
  elif [[ "$t" =~ ^(RUNNER|run\ ) ]]; then r="runner"
  elif [ "$mode" = "sub" ] && [[ "$t" =~ (review|re-grade|regrade|verdict|DECISION) ]]; then r="review"
  fi
  shopt -u nocasematch
  printf '%s' "$r"
}

# file_role FILE -> role. Computed once per file; reads at most the first 60
# lines (only when the path and seat table don't already decide it).
file_role() {
  local f="$1" rel proj sid text r
  rel="${f#"$JSONL_ROOT"/}"
  proj="${rel%%/*}"
  if [[ "$proj" == *wm-build-wt-* || "$rel" == *wm-build/wt/* ]]; then
    echo inner; return
  fi
  if [[ "$rel" == */subagents/* ]]; then
    text="$(head -n 60 -- "$f" 2>/dev/null | jq -r "$JQ_FIRST_TEXT" 2>/dev/null | head -n1)"
    r="$(role_from_text "$text" sub)"
    echo "${r:-scout}"; return
  fi
  sid="$(basename -- "$f" .jsonl)"
  if [ -n "${SEAT_BY_SID[$sid]:-}" ]; then
    echo "seat:${SEAT_BY_SID[$sid]}"; return
  fi
  text="$(head -n 60 -- "$f" 2>/dev/null | jq -r "$JQ_FIRST_TEXT" 2>/dev/null | head -n1)"
  r="$(role_from_text "$text" top)"
  echo "${r:-interactive}"
}

# file_role_prior FILE -> the role a top-level file would have WITHOUT its aide-sids line (text rule, else interactive):
# what rows of an aide-lane sid stamped before its `since=` keep (a plain session resumed as a lane never charges its earlier turns to the lane).
file_role_prior() {
  local text r
  text="$(head -n 60 -- "$1" 2>/dev/null | jq -r "$JQ_FIRST_TEXT" 2>/dev/null | head -n1)"
  r="$(role_from_text "$text" top)"
  echo "${r:-interactive}"
}

# file_tooling FILE -> "1" when the transcript's session cwd (first .cwd field in its first 60 lines) is a git checkout whose
# origin is one of the TOOLING_REPOS_RE repos (tooling budget, Joe 10-29 approvals #62), else "". A session with no cwd field, a
# cwd that no longer exists, no origin, or any other origin is NOT tooling. Cached per cwd.
TOOLING_REPOS_RE='(^|[/:])j0yen/(swarm-decide|dotfiles|wm-build)(\.git)?/?$'
declare -A TOOLING_BY_CWD=()
file_tooling() {
  local cwd url
  cwd="$(head -n 60 -- "$1" 2>/dev/null | jq -r 'select(.cwd != null) | .cwd' 2>/dev/null | head -n1)"
  [ -n "$cwd" ] || return 0
  if [ -z "${TOOLING_BY_CWD[$cwd]+x}" ]; then
    TOOLING_BY_CWD["$cwd"]=""
    if [ -d "$cwd" ]; then
      url="$(git -C "$cwd" remote get-url origin 2>/dev/null || true)"
      [[ "$url" =~ $TOOLING_REPOS_RE ]] && TOOLING_BY_CWD["$cwd"]=1
    fi
  fi
  printf '%s' "${TOOLING_BY_CWD[$cwd]}"
}

# gather_raw SINCE -> this host's own raw (non-deduped) records as NDJSON,
# tagged host=$LOCAL_HOST. The mtime prefilter only skips whole files that
# could not possibly hold anything in range; the real per-record window
# filter happens later, centrally, after dedup (a message's true final
# line decides both its day and whether it's in scope).
gather_raw() {
  local since="$1" cutoff_epoch
  cutoff_epoch="$(date -u -d "$since - 1 day" +%s 2>/dev/null || echo 0)"
  load_seats
  load_aide_sids
  local f role sidf since prior tool
  while IFS= read -r -d '' f; do
    role="$(file_role "$f")"
    since=0; prior="$role"; sidf="$(basename -- "$f" .jsonl)"
    if [[ "$role" == seat:aide:* ]] && [[ "$f" != */subagents/* ]] && [ "${SINCE_BY_SID[$sidf]:-0}" -gt 0 ] 2>/dev/null; then
      since="${SINCE_BY_SID[$sidf]}"; prior="$(file_role_prior "$f")"
    fi
    tool="$(file_tooling "$f")"
    jq -c --arg host "$LOCAL_HOST" --arg role "$role" --arg prior "$prior" --argjson since "$since" --arg tool "$tool" \
      "(($JQ_EXTRACT), ($JQ_COMPACT)) | . + (if \$tool == \"1\" then {tooling: true} else {} end) + {host:\$host, role: (if \$since > 0 and ((.ts | sub(\"\\\\.[0-9]+\"; \"\") | try fromdateiso8601 catch \$since) < \$since) then \$prior else \$role end)}" -- "$f" 2>/dev/null
  done < <(find "$JSONL_ROOT" -type f -name '*.jsonl' -newermt "@$cutoff_epoch" -print0 2>/dev/null)
}

# --emit-local-records is handled first and standalone: it never touches
# $STATE_DIR, never talks to other hosts, and is what runs (via ssh, same
# binary) on every OTHER fleet host when this script is the orchestrator.
if [ "${1:-}" = "--emit-local-records" ]; then
  shift
  since_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since_arg="${2:-}"; shift 2 ;;
      --until) shift 2 ;;  # accepted for symmetry; emit mode never window-filters
      *) shift ;;
    esac
  done
  [ -n "$since_arg" ] || die "--emit-local-records requires --since"
  gather_raw "$since_arg"
  exit 0
fi

since=""
until_=""
day=""
check=0
while [ $# -gt 0 ]; do
  case "$1" in
    --since) since="${2:-}"; shift 2 ;;
    --until) until_="${2:-}"; shift 2 ;;
    --day) day="${2:-}"; shift 2 ;;
    --check) check=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

mkdir -p "$STATE_DIR"

# ---- migration: an old-format ledger.tsv (pre this PRD; overlapping
# run-labeled rows) is renamed aside and rebuilt from JSONL for whatever
# days are still on disk — never invented, never silently merged. ------
migrate_legacy_ledger() {
  [ -f "$LEDGER_TSV" ] || return 0
  local first_line
  first_line="$(head -n1 -- "$LEDGER_TSV" 2>/dev/null || true)"
  { [ "$first_line" = "$LEDGER_HEADER" ] || [ "$first_line" = "$LEDGER_HEADER_V2" ] \
    || [ "$first_line" = "$LEDGER_HEADER_V1" ]; } && return 0
  local bak="$STATE_DIR/ledger.tsv.pre-buckets"
  [ -e "$bak" ] && bak="$STATE_DIR/ledger.tsv.pre-buckets.$(date -u +%Y%m%dT%H%M%SZ)"
  mv -- "$LEDGER_TSV" "$bak"
  printf 'token-ledger: migrated legacy ledger -> %s\n' "$bak" >&2
}
migrate_legacy_ledger

# ---- --check (P1): validate current on-disk state, no JSONL rescan. ----
if [ "$check" -eq 1 ]; then
  fail=0
  if [ -f "$LEDGER_TSV" ]; then
    while IFS=$'\t' read -r c_date c_permodel c_weighted _rest; do
      [ "$c_date" = "date" ] && continue
      [ -z "$c_date" ] && continue
      sum=0
      if [ -n "$c_permodel" ]; then
        IFS=';' read -ra parts <<< "$c_permodel"
        for p in "${parts[@]}"; do
          [ -z "$p" ] && continue
          w="${p#*=}"
          sum=$((sum + w))
        done
      fi
      if [ "$sum" != "$c_weighted" ]; then
        printf 'token-ledger --check: %s: weighted=%s but per_model sums to %s\n' "$c_date" "$c_weighted" "$sum" >&2
        fail=1
      fi
    done < "$LEDGER_TSV"
  fi
  if [ -f "$INDEX_TSV" ]; then
    declare -A id_date
    while IFS=$'\t' read -r m_id m_date; do
      [ -z "$m_id" ] && continue
      if [ -n "${id_date[$m_id]:-}" ] && [ "${id_date[$m_id]}" != "$m_date" ]; then
        printf 'token-ledger --check: message %s counted in day %s and %s\n' "$m_id" "${id_date[$m_id]}" "$m_date" >&2
        fail=1
      else
        id_date[$m_id]="$m_date"
      fi
    done < "$INDEX_TSV"
  fi
  if [ "$fail" -eq 0 ]; then
    echo "token-ledger --check: ok"
  fi
  exit "$fail"
fi

# ---- window: --day pins since/until to that day's UTC boundaries; ------
# otherwise default until=now, default since=earliest incomplete day in
# ledger.tsv (or yesterday 00:00Z when the file is empty/absent). --------
if [ -n "$day" ]; then
  since="${day}T00:00:00Z"
  until_="$(date -u -d "$day +1 day" +%FT%TZ)"
fi

[ -n "$until_" ] || until_="$NOW"

default_since() {
  if [ -f "$LEDGER_TSV" ]; then
    local earliest
    earliest="$(tail -n +2 -- "$LEDGER_TSV" 2>/dev/null | awk -F'\t' '$5=="no"{print $1}' | sort | head -n1)"
    if [ -n "$earliest" ]; then
      printf '%sT00:00:00Z\n' "$earliest"
      return
    fi
  fi
  printf '%sT00:00:00Z\n' "$(date -u -d "$NOW -1 day" +%F)"
}
[ -n "$since" ] || since="$(default_since)"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
records_file="$work/records.ndjson"
: > "$records_file"

gather_raw "$since" >> "$records_file"

missing_hosts=()
reachable_hosts=("$LOCAL_HOST")
for h in $HOSTS_STR; do
  [ "$h" = "$LOCAL_HOST" ] && continue
  hf="$work/remote-$h.ndjson"
  if timeout "$SSH_TIMEOUT" ssh -o BatchMode=yes -o ConnectTimeout=5 "$h" \
       '"$HOME/.local/bin/token-ledger"' --emit-local-records --since "$since" > "$hf" 2>/dev/null; then
    cat -- "$hf" >> "$records_file"
    reachable_hosts+=("$h")
  else
    missing_hosts+=("$h")
  fi
done

hosts_csv="$(printf '%s\n' "${reachable_hosts[@]}" | sort -u | paste -sd, -)"
missing_csv=""
[ "${#missing_hosts[@]}" -gt 0 ] && missing_csv="$(printf '%s\n' "${missing_hosts[@]}" | sort -u | paste -sd, -)"

# ---- dedup by message.id (keep the latest ts), THEN window-filter, THEN
# bucket by the winning record's own day. -----------------------------
agg_json="$(jq -n --arg since "$since" --arg until "$until_" '
  [inputs] as $all
  | ($all | map(select(.kind != "compact"))) as $usage
  | ($all | map(select(.kind == "compact")) | group_by(.id) | map(sort_by(.ts) | first)
     | map(select(.ts >= $since and .ts < $until))) as $comp
  | $usage
  | group_by(.id)
  | map(sort_by(.ts) | last)
  | map(select(.ts >= $since and .ts < $until))
  | group_by(.ts[0:10])
  | map({
      date: .[0].ts[0:10],
      split: {in: ([.[].in] | add // 0), cw: ([.[].cw] | add // 0),
              cr: ([.[].cr] | add // 0), out: ([.[].out] | add // 0)},
      per_host: (
        group_by(.host // "unknown")
        | map({host: (.[0].host // "unknown"), w: ([.[] | (.in + .cw*1.25 + .cr*0.1 + .out*5)] | add | round)})
        | sort_by(.host)
      ),
      per_model: (
        group_by(.model)
        | map({model: .[0].model, w: ([.[] | (.in + .cw*1.25 + .cr*0.1 + .out*5)] | add | round)})
        | sort_by(.model)
      ),
      per_role: (
        map(. + {role: (.role // "unknown")})
        | group_by(.role)
        | map({role: .[0].role, w: ([.[] | (.in + .cw*1.25 + .cr*0.1 + .out*5)] | add | round)})
        | sort_by(.role)
      ),
      tooling: ([.[] | select(.tooling == true) | (.in + .cw*1.25 + .cr*0.1 + .out*5)] | add // 0 | round),
      ids: [.[].id]
    })
  | map(. + {weighted: ([.per_model[].w] | add // 0)})
  | map(. as $d | . + {compactions: ($comp | map(select(.ts[0:10] == $d.date)) | length)})
' "$records_file")"

declare -A old_rows
declare -A tool_rows   # date -> tooling weighted for the days this run recomputed (sidecar tooling-daily.tsv)
if [ -f "$LEDGER_TSV" ]; then
  while IFS=$'\t' read -r r_date r_rest; do
    [ "$r_date" = "date" ] && continue
    [ -z "$r_date" ] && continue
    old_rows["$r_date"]="$r_date"$'\t'"$r_rest"
  done < "$LEDGER_TSV"
fi

generated="$NOW"
new_index_entries="$work/new-index.tsv"
: > "$new_index_entries"

until_epoch="$(date -u -d "$until_" +%s)"
while IFS= read -r day_obj; do
  d_date="$(jq -r '.date' <<<"$day_obj")"
  d_weighted="$(jq -r '.weighted' <<<"$day_obj")"
  d_permodel="$(jq -r '[.per_model[] | "\(.model)=\(.w)"] | join(";")' <<<"$day_obj")"
  day_end_epoch="$(date -u -d "$d_date +1 day" +%s)"
  if [ "$day_end_epoch" -le "$until_epoch" ]; then d_complete="yes"; else d_complete="no"; fi
  d_status="$(status_for "$d_weighted")"
  d_split="$(jq -r '.split | "in=\(.in) cw=\(.cw) cr=\(.cr) out=\(.out)"' <<<"$day_obj")"
  d_perhost="$(jq -r '[.per_host[] | "\(.host)=\(.w)"] | join(" ")' <<<"$day_obj")"
  d_compactions="$(jq -r '.compactions' <<<"$day_obj")"
  d_perrole="$(jq -r '[.per_role[] | "\(.role)=\(.w)"] | join(";")' <<<"$day_obj")"
  tool_rows["$d_date"]="$(jq -r '.tooling // 0' <<<"$day_obj")"
  old_rows["$d_date"]="$d_date"$'\t'"$d_permodel"$'\t'"$d_weighted"$'\t'"$d_status"$'\t'"$d_complete"$'\t'"$hosts_csv"$'\t'"$missing_csv"$'\t'"$generated"$'\t'"$d_split"$'\t'"$d_perhost"$'\t'"$d_compactions"$'\t'"$d_perrole"
  jq -r --arg d "$d_date" '.ids[] | "\(.)\t\($d)"' <<<"$day_obj" >> "$new_index_entries"
done < <(jq -c '.[]' <<<"$agg_json")

tmp_ledger="$STATE_DIR/.ledger.tsv.tmp.$$"
{
  printf '%s\n' "$LEDGER_HEADER"
  if [ "${#old_rows[@]}" -gt 0 ]; then
    # rows written before the split/per_host/compactions/per_role columns existed are
    # padded with empty cells so every row has LEDGER_NCOLS fields
    for d in "${!old_rows[@]}"; do printf '%s\n' "${old_rows[$d]}"; done \
      | awk -F'\t' -v OFS='\t' -v n="$LEDGER_NCOLS" '{for (i=NF+1;i<=n;i++) $i=""; print}' | sort
  fi
} > "$tmp_ledger"
mv -- "$tmp_ledger" "$LEDGER_TSV"

tmp_index="$STATE_DIR/.message-index.tsv.tmp.$$"
{ [ -f "$INDEX_TSV" ] && cat -- "$INDEX_TSV"; cat -- "$new_index_entries"; } 2>/dev/null \
  | awk -F'\t' 'NF>=2{line[$1]=$0} END{for (k in line) print line[k]}' \
  | sort \
  > "$tmp_index"
mv -- "$tmp_index" "$INDEX_TSV"

# ---- today-summary.txt: always regenerated relative to $until_, not real
# wall-clock time — this is what makes historical/fixture runs hermetic. -
get_field() { # DATE COLUMN(1-based) DEFAULT
  awk -F'\t' -v d="$1" -v c="$2" -v dflt="$3" '$1==d{print $c; f=1} END{if(!f) print dflt}' "$LEDGER_TSV" 2>/dev/null
}

today_date="$(date -u -d "$until_" +%F)"
yesterday_date="$(date -u -d "$today_date -1 day" +%F)"
y_weighted="$(get_field "$yesterday_date" 3 0)"
y_status="$(get_field "$yesterday_date" 4 "budget off")"
t_weighted="$(get_field "$today_date" 3 0)"
t_split="$(get_field "$today_date" 9 "")"
t_compactions="$(get_field "$today_date" 11 0)"
[ -n "$t_compactions" ] || t_compactions=0
# split cell "in=N cw=N cr=N out=N" -> "N/N/N/N" (0/0/0/0 when absent)
t_split_slash="$(sed -E 's/(in|cw|cr|out)=//g; s/ /\//g' <<<"${t_split:-in=0 cw=0 cr=0 out=0}")"

hhmm="$(date -u -d "$until_" +%H:%M)"
hh="$((10#$(date -u -d "$until_" +%H)))"
today_00z_epoch="$(date -u -d "$today_date" +%s)"
hours_elapsed_x100=$(( (until_epoch - today_00z_epoch) * 100 / 3600 ))

if [ "$hh" -lt 2 ]; then
  forecast="n/a"
else
  forecast="$(awk -v w="$t_weighted" -v h="$hours_elapsed_x100" 'BEGIN{printf "%.0f", (w*24*100)/h}')"
fi

summary="TOKENS yesterday ${yesterday_date}: ${y_weighted} ${y_status} · today so far ${t_weighted} (${hhmm}Z) · forecast ${forecast} · hosts ${hosts_csv} missing ${missing_csv} · split in/cw/cr/out ${t_split_slash} · compactions ${t_compactions}"

# ---- build_share: BUILD_ROLES_RE weighted share of today's total minus the
# EXCLUDE_ROLES_RE roles (left out of numerator and denominator). Unknown
# (older row without per_role) is "n/a" and never alarms. ----------------
t_perrole="$(get_field "$today_date" 12 "")"
bs_alarm=""
lane_alarms=""; lanes_json="{}"
bs_json_share="null"
t_excl=0
t_denom="${t_weighted:-0}"
if [ -n "$t_perrole" ] && [ "${t_weighted:-0}" -gt 0 ] 2>/dev/null; then
  t_excl="$(awk -F';' -v re="$EXCLUDE_ROLES_RE" '{for(i=1;i<=NF;i++){split($i,a,"="); if(a[1] ~ re) s+=a[2]}} END{printf "%d", s}' <<<"$t_perrole")"
  t_denom=$(( t_weighted - t_excl ))
fi
if [ -n "$t_perrole" ] && [ "$t_denom" -gt 0 ] 2>/dev/null; then
  t_build="$(awk -F';' -v re="$BUILD_ROLES_RE" '{for(i=1;i<=NF;i++){split($i,a,"="); if(a[1] ~ re) s+=a[2]}} END{printf "%d", s}' <<<"$t_perrole")"
  bs_pct=$(( t_build * 100 / t_denom ))
  bs_json_share="$(awk -v b="$t_build" -v t="$t_denom" 'BEGIN{printf "%.1f", b*100/t}')"
  summary="$summary · build_share ${bs_pct}% (${BUILD_ROLES_LABEL} $(( (t_build + 500000) / 1000000 ))M of $(( (t_denom + 500000) / 1000000 ))M; interactive $(( (t_excl + 500000) / 1000000 ))M excluded)"
  if [ "$bs_pct" -lt 50 ] && [ "$t_denom" -gt 50000000 ]; then
    bs_alarm="ALARM build_share ${bs_pct}% < 50% — building is ${BUILD_ROLES_LABEL} (ctl/rb/r7/aide); the rest is management"
  fi
  # aide lanes: one entry per lane seen today (role seat:aide = main, seat:aide:<lane>), share of the same denominator as build_share
  lane_tsv="$(awk -F';' -v den="$t_denom" '{for(i=1;i<=NF;i++){split($i,a,"="); if(a[1]=="seat:aide") print "main\t" a[2] "\t" int(a[2]*100/den); else if(a[1] ~ /^seat:aide:/){l=a[1]; sub(/^seat:aide:/,"",l); print l "\t" a[2] "\t" int(a[2]*100/den)}}}' <<<"$t_perrole" | sort | awk -F'\t' '$1=="main"{m=$0; next} {r=r $0 "\n"} END{if(m!="") print m; printf "%s", r}')"
  # only when a NON-main lane has tokens today: a main-only day keeps origin/main's summary + build-share.json byte for byte
  if [ -n "$lane_tsv" ] && [ -n "$(awk -F'\t' '$1!="main"' <<<"$lane_tsv")" ]; then
    lane_x="${AIDE_LANE_ALARM_PCT:-50}"; [[ "$lane_x" =~ ^[0-9]{1,3}$ ]] || lane_x=50
    summary="$summary · aide $(awk -F'\t' '{printf "%s%s=%s%%", (NR>1?" ":""), $1, $3}' <<<"$lane_tsv")"
    while IFS=$'\t' read -r l_name l_tok l_pct; do
      [ "$l_name" != main ] && [ "$l_pct" -gt "$lane_x" ] && lane_alarms="${lane_alarms}${lane_alarms:+$'\n'}ALARM aide_lane ${l_name} ${l_pct}% > ${lane_x}% — one lane is eating the day"
    done <<<"$lane_tsv"
    lanes_json="$(jq -Rn '[inputs | split("\t") | {(.[0]): {tokens: (.[1]|tonumber), pct: (.[2]|tonumber)}}] | add' <<<"$lane_tsv")"
  fi
else
  t_build=0
  t_excl=0
  t_denom="${t_weighted:-0}"
  summary="$summary · build_share n/a"
fi

# ---- tooling_share (Joe 10-29 approvals #62, goal.md TOOLING BUDGET): weighted tokens of sessions whose cwd is a swarm-decide /
# dotfiles / wm-build checkout, over the trailing TOOLING_WINDOW_DAYS days ending today, / ALL weighted tokens of the same days.
# Numerator from the sidecar tooling-daily.tsv (date, weighted; upserted per recomputed day, so days before this feature shipped
# count 0 until re-run with --day), denominator from ledger.tsv col 3. Alarm at 80 % of the budget; the coder-spawn refusal at
# 100 % lives in .local/lib/tooling-budget.sh.
TOOLING_WINDOW_DAYS=7
TOOLING_BUDGET=0.05
TOOLING_DAILY_TSV="$STATE_DIR/tooling-daily.tsv"
tmp_tool="$STATE_DIR/.tooling-daily.tsv.tmp.$$"
{
  for d in "${!tool_rows[@]}"; do printf '%s\t%s\n' "$d" "${tool_rows[$d]}"; done
  [ -f "$TOOLING_DAILY_TSV" ] && cat -- "$TOOLING_DAILY_TSV"
} 2>/dev/null | awk -F'\t' 'NF>=2 && !($1 in seen){seen[$1]=1; print}' | sort > "$tmp_tool"
mv -- "$tmp_tool" "$TOOLING_DAILY_TSV"
tool_from="$(date -u -d "$today_date -$((TOOLING_WINDOW_DAYS - 1)) day" +%F)"
tool_w="$(awk -F'\t' -v a="$tool_from" -v b="$today_date" '$1>=a && $1<=b{s+=$2} END{printf "%d", s}' "$TOOLING_DAILY_TSV")"
tool_den="$(awk -F'\t' -v a="$tool_from" -v b="$today_date" '$1>=a && $1<=b && $1!="date"{s+=$3} END{printf "%d", s}' "$LEDGER_TSV")"
tool_share="null"; tool_alarm=""
if [ "${tool_den:-0}" -gt 0 ] 2>/dev/null; then
  tool_share="$(awk -v t="$tool_w" -v d="$tool_den" 'BEGIN{printf "%.4f", t/d}')"
  if awk -v s="$tool_share" -v b="$TOOLING_BUDGET" 'BEGIN{exit !(s >= 0.8*b)}'; then
    tool_alarm="ALARM tooling_share=$(awk -v s="$tool_share" 'BEGIN{printf "%.1f", s*100}') % >= 80 % of 5 % budget"
  fi
fi

tmp_summary="$STATE_DIR/.today-summary.txt.tmp.$$"
{ printf '%s\n' "$summary"; [ -n "$bs_alarm" ] && printf '%s\n' "$bs_alarm"; [ -n "$lane_alarms" ] && printf '%s\n' "$lane_alarms"; [ -n "$tool_alarm" ] && printf '%s\n' "$tool_alarm"; true; } > "$tmp_summary"
mv -- "$tmp_summary" "$SUMMARY_TXT"

tmp_bs="$STATE_DIR/.build-share.json.tmp.$$"
jq -n --arg date "$today_date" --argjson share "$bs_json_share" \
      --argjson build "${t_build:-0}" --argjson total "${t_weighted:-0}" --arg pr "$t_perrole" --arg roles "$BUILD_ROLES_RE" \
      --argjson excl "${t_excl:-0}" --argjson denom "${t_denom:-0}" --arg xroles "$EXCLUDE_ROLES_RE" --argjson lanes "${lanes_json:-{\}}" \
      --argjson tshare "$tool_share" --argjson tw "${tool_w:-0}" --argjson twin "$TOOLING_WINDOW_DAYS" --argjson tbud "$TOOLING_BUDGET" '
  {date: $date, build_share: $share, build_weighted: $build, total_weighted: $total, build_roles_re: $roles,
   excluded_weighted: $excl, share_denominator: $denom, excluded_roles_re: $xroles,
   tooling_share: $tshare, tooling_weighted: $tw, tooling_window_days: $twin, tooling_budget: $tbud}
  + (if ($lanes | length) > 0 then {aide_lanes: $lanes} else {} end)
  + {per_role: ($pr | split(";") | map(select(length > 0) | split("=") | {(.[0]): (.[1] | tonumber)}) | add // {})}' \
  > "$tmp_bs" && mv -- "$tmp_bs" "$BUILD_SHARE_JSON"

exit 0
