#!/usr/bin/env python3
"""carbon-alive (A1446): off-host witness of carbon, run by a user timer on ryzen7 and RedBaron.

One cycle reads carbon over one fixed read-only ssh command and classifies six
dimensions as UP, DOWN, STALE or UNKNOWN:
  host          ssh reaches carbon; an ssh failure is DOWN only while this host
                still reaches CARBON_ALIVE_REF, else UNKNOWN (witness-side flap)
  user_manager  user@1000.service; a changed ActiveEnterTimestamp is a restart event
  gateway       hermes-gateway.service (user unit)
  bus           agorabus processes + wm-busbridge.service
  executor      hermes agent.log age (useful work, not just a running process)
  evidence      fleet-dash status.json age (stale evidence)
A dimension opens one incident after OPEN_AFTER bad cycles and closes it after
RECOVER_AFTER good ones; host UNKNOWN for UNKNOWN_OPEN_AFTER cycles opens an
UNKNOWN incident. Each transition is queued in a file outbox and posted straight
from this host to a dedicated Discord webhook; nothing on the delivery path
touches carbon, Hermes or the bus. Undelivered messages replay in order and say
how long they were held. No remediation, no dispatch, no approval authority.
The ssh login itself opens a PAM session on carbon, which can start a stopped
user manager; the restart event reports that case when the start time is
within RESTART_BY_PROBE_S of the probe.
"""
import fcntl
import json
import os
import socket
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
STATE = os.environ.get("CARBON_ALIVE_STATE_DIR", f"{HOME}/.local/state/carbon-alive")
WEBHOOK_FILE = os.environ.get("CARBON_ALIVE_WEBHOOK_FILE", f"{HOME}/.config/carbon-alive/webhook.url")
TARGET = os.environ.get("CARBON_ALIVE_TARGET", "carbon")
REF = os.environ.get("CARBON_ALIVE_REF", "discord.com:443")
PROBE_FILE = os.environ.get("CARBON_ALIVE_PROBE_FILE")  # synthetic tests only
WITNESS = os.environ.get("CARBON_ALIVE_WITNESS", socket.gethostname())

DIMS = ("host", "user_manager", "gateway", "bus", "executor", "evidence")
OPEN_AFTER = {"host": 3, "user_manager": 2, "gateway": 3, "bus": 3, "executor": 1, "evidence": 2}
RECOVER_AFTER = 2
UNKNOWN_OPEN_AFTER = 10
EVIDENCE_MAX_AGE = 300
EXECUTOR_MAX_AGE = 1800
MAX_SKEW = 120
RESTART_BY_PROBE_S = 20
HELD_NOTE_AFTER = 120
SENT_KEEP = 500
BAD = ("DOWN", "STALE")

REMOTE = (
    "echo now=$(date +%s);"
    " echo um=$(systemctl is-active user@1000.service 2>/dev/null);"
    " echo umsince=$(systemctl show --timestamp=unix -p ActiveEnterTimestamp --value user@1000.service 2>/dev/null);"
    " echo gw=$(XDG_RUNTIME_DIR=/run/user/1000 timeout 5 systemctl --user is-active hermes-gateway.service 2>/dev/null);"
    " echo bridge=$(XDG_RUNTIME_DIR=/run/user/1000 timeout 5 systemctl --user is-active wm-busbridge.service 2>/dev/null);"
    " echo bus=$(pgrep -c -u 1000 -x agorabus);"
    " echo dash=$(stat -c %Y /home/jsy/.cache/fleet-dash/status.json 2>/dev/null);"
    " echo exec=$(stat -c %Y /home/jsy/.hermes/logs/agent.log 2>/dev/null);"
    " echo end=1"
)


def now():
    v = os.environ.get("CARBON_ALIVE_NOW")
    return float(v) if v else time.time()


def hm(t):
    return time.strftime("%-I:%M %p %Z", time.localtime(t))


def dur(s):
    s = int(s)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def atomic_write(path, text):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def ref_reachable():
    host, port = REF.rsplit(":", 1)
    try:
        socket.create_connection((host, int(port)), timeout=5).close()
        return True
    except OSError:
        return False


def probe():
    """Return (stdout or None, reason)."""
    if PROBE_FILE:
        with open(PROBE_FILE) as f:
            text = f.read()
        return (None, "ssh rc=255 (synthetic)") if text.strip() == "SSH_FAIL" else (text, "")
    env = {"PATH": "/usr/bin:/bin", "HOME": HOME, "LANG": "C.UTF-8"}
    argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=5",
            "-o", "ServerAliveCountMax=2", TARGET, REMOTE]
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=30, env=env,
                           stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, "ssh timeout 30s"
    if p.returncode == 255:
        return None, "ssh rc=255"
    return p.stdout, ("" if p.returncode == 0 else f"ssh rc={p.returncode}")


def unit_state(value, name):
    if value == "active":
        return "UP", f"{name} active"
    if value in ("inactive", "failed", "deactivating"):
        return "DOWN", f"{name} {value}"
    return "UNKNOWN", f"{name} state '{value}'"


def classify(text, reason, t):
    obs = {d: ("UNKNOWN", "host not reached") for d in DIMS}
    if text is None:
        if ref_reachable():
            obs["host"] = ("DOWN", f"unreachable ({reason}); witness reaches {REF}")
        else:
            obs["host"] = ("UNKNOWN", f"unreachable ({reason}); witness cannot reach {REF} either")
        return obs, {}
    kv = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    if kv.get("end") != "1" or not kv.get("now", "").isdigit():
        obs["host"] = ("UNKNOWN", f"probe output malformed {reason}".strip())
        for d in DIMS[1:]:
            obs[d] = ("UNKNOWN", "probe output malformed")
        return obs, {}
    obs["host"] = ("UP", "ssh ok")
    rnow = int(kv["now"])
    um = kv.get("um", "")
    obs["user_manager"] = unit_state(um, "user@1000")
    if um == "active":
        obs["gateway"] = unit_state(kv.get("gw", ""), "hermes-gateway")
        n, br = kv.get("bus", ""), kv.get("bridge", "")
        if n == "0":
            obs["bus"] = ("DOWN", "no agorabus process")
        elif br in ("inactive", "failed"):
            obs["bus"] = ("DOWN", f"wm-busbridge {br}")
        elif n.isdigit() and br == "active":
            obs["bus"] = ("UP", f"agorabus x{n}, wm-busbridge active")
        else:
            obs["bus"] = ("UNKNOWN", f"agorabus '{n}', wm-busbridge '{br}'")
    else:
        obs["gateway"] = ("UNKNOWN", "user manager not active")
        obs["bus"] = ("UNKNOWN", "user manager not active")
    skew = rnow - t
    for dim, key, label, limit in (("evidence", "dash", "fleet-dash status.json", EVIDENCE_MAX_AGE),
                                   ("executor", "exec", "hermes agent.log", EXECUTOR_MAX_AGE)):
        v = kv.get(key, "")
        if abs(skew) > MAX_SKEW:
            obs[dim] = ("UNKNOWN", f"clock skew {int(skew)}s")
        elif not v.isdigit():
            obs[dim] = ("UNKNOWN", f"{label} mtime missing")
        else:
            age = rnow - int(v)
            if age < -MAX_SKEW:
                obs[dim] = ("UNKNOWN", f"{label} timestamp {-age}s in the future")
            elif age > limit:
                obs[dim] = ("STALE", f"{label} {dur(age)} old")
            else:
                obs[dim] = ("UP", f"{label} {dur(max(age, 0))} old")
    return obs, kv


def evaluate(st, obs, kv, t):
    msgs = []
    for d in DIMS:
        s, detail = obs[d]
        x = st["dims"].setdefault(d, {"open": None, "bad": 0, "good": 0, "unknown": 0,
                                      "bad_since": None, "unknown_since": None})
        x["last"] = [s, detail, t]
        if s in BAD:
            if x["bad"] == 0:
                x["bad_since"] = t
            x["bad"] += 1
            x["good"] = x["unknown"] = 0
            o = x["open"]
            if x["bad"] >= OPEN_AFTER[d] and (o is None or o["kind"] == "UNKNOWN"):
                was = f" (was UNKNOWN since {hm(o['since'])})" if o else ""
                x["open"] = {"id": f"{d}-{int(x['bad_since'])}", "since": x["bad_since"], "kind": s, "detail": detail}
                msgs.append((f"{x['open']['id']}-open",
                             f"{s} carbon {d}: {detail}; since {hm(x['bad_since'])}, {x['bad']} checks{was}"))
        elif s == "UP":
            x["good"] += 1
            x["bad"] = x["unknown"] = 0
            o = x["open"]
            if o is not None and x["good"] >= RECOVER_AFTER:
                x["open"] = None
                msgs.append((f"{o['id']}-recover",
                             f"RECOVERED carbon {d} after {dur(t - o['since'])}; was {o['kind']}: {o['detail']}"))
        else:
            if x["unknown"] == 0:
                x["unknown_since"] = t
            x["unknown"] += 1
            x["good"] = 0  # recovery needs consecutive UP checks; a bad streak survives an UNKNOWN
            if d == "host" and x["open"] is None and x["unknown"] >= UNKNOWN_OPEN_AFTER:
                x["open"] = {"id": f"host-u{int(x['unknown_since'])}", "since": x["unknown_since"],
                             "kind": "UNKNOWN", "detail": detail}
                msgs.append((f"{x['open']['id']}-open",
                             f"UNKNOWN carbon host: {detail}; since {hm(x['unknown_since'])}, {x['unknown']} checks"))
    since = kv.get("umsince", "").lstrip("@").split(".")[0]
    if since.isdigit() and kv.get("um") == "active":
        prev = st.get("umsince")
        if prev and prev != int(since):
            note = ""
            if int(kv["now"]) - int(since) <= RESTART_BY_PROBE_S:
                note = "; start falls inside this probe's ssh login, which can start a stopped manager"
            msgs.append((f"um-restart-{since}",
                         f"RESTART carbon user@1000: active since {hm(int(since))}, previous start {hm(prev)}{note}"))
        st["umsince"] = int(since)
    return msgs


def enqueue(st, key, text, t):
    for sub in ("outbox", "sent"):
        if any(n.endswith(f"-{key}.json") for n in os.listdir(f"{STATE}/{sub}")):
            return
    st["seq"] += 1
    name = f"{st['seq']:08d}-{key}.json"
    atomic_write(f"{STATE}/outbox/{name}",
                 json.dumps({"key": key, "text": f"[carbon-alive {WITNESS}] {text}", "queued": t, "attempts": 0}))


def read_webhook():
    try:
        fd = os.open(WEBHOOK_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None, "unconfigured: no webhook file"
    with os.fdopen(fd) as f:
        info = os.fstat(f.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
            return None, "unconfigured: webhook file not a private regular file"
        url = f.read(4096).strip()
    if url.startswith("https://") or url.startswith("http://127.0.0.1:"):
        return url, ""
    return None, "unconfigured: webhook file content not an https url"


def deliver(st, t):
    d = st["delivery"]
    out = f"{STATE}/outbox"
    pend = sorted(n for n in os.listdir(out) if n.endswith(".json"))
    url, why = read_webhook()
    if not pend:
        d.update(state="ok" if url else why, pending=0, oldest=None, last_error=None, failing_since=None)
        return
    if url is None:
        d.update(state=why, pending=len(pend))
        d["oldest"] = json.load(open(f"{out}/{pend[0]}"))["queued"]
        return
    for name in pend:
        m = json.load(open(f"{out}/{name}"))
        text = m["text"]
        if t - m["queued"] > HELD_NOTE_AFTER:
            text += f" [delivered late: held {dur(t - m['queued'])} since {hm(m['queued'])}]"
        body = json.dumps({"content": text[:1900], "username": "carbon-alive",
                           "allowed_mentions": {"parse": []}}).encode()
        req = urllib.request.Request(url, data=body, method="POST",
                                     headers={"Content-Type": "application/json", "User-Agent": "carbon-alive"})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                code = r.status
        except urllib.error.HTTPError as e:
            code = e.code
        except Exception as e:  # never str(e): it can carry the url
            code = type(e).__name__
        if isinstance(code, int) and 200 <= code < 300:
            os.replace(f"{out}/{name}", f"{STATE}/sent/{name}")
            d["sent"] = d.get("sent", 0) + 1
        else:
            m["attempts"] += 1
            m["last_error"] = str(code)
            atomic_write(f"{out}/{name}", json.dumps(m))
            d.update(state="failing", last_error=str(code))
            d["failing_since"] = d.get("failing_since") or t
            break
    else:
        d.update(state="ok", last_error=None, failing_since=None)
    left = sorted(n for n in os.listdir(out) if n.endswith(".json"))
    d["pending"] = len(left)
    d["oldest"] = json.load(open(f"{out}/{left[0]}"))["queued"] if left else None
    sent = sorted(os.listdir(f"{STATE}/sent"))
    for n in sent[:-SENT_KEEP]:
        os.unlink(f"{STATE}/sent/{n}")


def load_state():
    try:
        with open(f"{STATE}/state.json") as f:
            return json.load(f)
    except FileNotFoundError:
        return {"seq": 0, "dims": {}, "delivery": {}, "umsince": None}


def cycle():
    for sub in ("", "/outbox", "/sent"):
        os.makedirs(STATE + sub, mode=0o700, exist_ok=True)
    with open(f"{STATE}/lock", "w") as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("carbon-alive: previous cycle still running")
            return 0
        t = now()
        st = load_state()
        text, reason = probe()
        obs, kv = classify(text, reason, t)
        for key, msg in evaluate(st, obs, kv, t):
            enqueue(st, key, msg, t)
        atomic_write(f"{STATE}/state.json", json.dumps(st))
        deliver(st, t)
        st["last_cycle"] = t
        atomic_write(f"{STATE}/state.json", json.dumps(st))
        summary = {"witness": WITNESS, "target": TARGET, "cycle_at": t,
                   "dims": {d: obs[d][0] for d in DIMS},
                   "open": {d: st["dims"][d]["open"]["kind"] for d in DIMS if st["dims"][d]["open"]},
                   "delivery": st["delivery"]}
        atomic_write(f"{STATE}/status.json", json.dumps(summary))
        print(" ".join(f"{d}={obs[d][0]}" for d in DIMS),
              f"open={','.join(summary['open']) or '-'}",
              f"pending={st['delivery'].get('pending', 0)}",
              f"delivery={st['delivery'].get('state', '-')}")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["status"]:
        with open(f"{STATE}/status.json") as f:
            print(f.read())
        sys.exit(0)
    sys.exit(cycle())
