#!/bin/bash
# pre-commit (rb --no-cargo coder, ctl 8220 11-03): a --no-cargo RedBaron coder never runs `cargo test`, so the wm-build test
# `act_every_journal_op_is_classified` (src/actor.rs) goes red only after publish. This hook runs its cargo-free mirror,
# .local/bin/wmb-nocargo-checks.sh, on the STAGED tree of a wm-build repo and refuses the commit on any finding.
# Any other repo (no src/actor.rs holding OPERATOR_OPS) passes untouched. Wired by rb-run-coder.sh --no-cargo via env-level core.hooksPath.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
grep -qs 'OPERATOR_OPS' "$top/src/actor.rs" || exit 0
bin="${WMB_NOCARGO_BIN:-$(cd "$(dirname "$(readlink -f "$0")")/../../bin" 2>/dev/null && pwd)/wmb-nocargo-checks.sh}"
[ -x "$bin" ] || { echo "pre-commit: REFUSED, wmb-nocargo-checks.sh not found at $bin" >&2; exit 1; }
tmp=$(mktemp -d) || exit 1; trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/" || { echo "pre-commit: REFUSED, could not export the index" >&2; exit 1; }
out=$("$bin" "$tmp" 2>&1); rc=$?
[ "$rc" = 0 ] && exit 0
printf '%s\n' "$out" | head -n 20 >&2
echo "pre-commit: REFUSED, wmb-nocargo-checks rc=$rc on the staged tree (classify the journal op in src/actor.rs OPERATOR_OPS or NON_OPERATOR_OPS, then commit)" >&2
exit 1
