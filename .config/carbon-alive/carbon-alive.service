[Unit]
Description=carbon-alive: off-host witness of carbon, direct off-carbon alert (A1446)
# PREMISE: carbon's own recoverers die with user@1000; a reader on another host reports it.
# System scope so the witness does not depend on this host's own user manager.
# EXPIRES: replaced by an accepted A1355 cloud watchdog carbon check, or by Hermes' word.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jsy
Group=jsy
Environment=HOME=/home/jsy
ExecStart=/usr/bin/python3 -I /home/jsy/.local/bin/carbon-alive
TimeoutStartSec=90
Nice=10
