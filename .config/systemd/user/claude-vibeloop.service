[Unit]
Description=Launch one Claude /vibeloop cycle as claude-vibeloop-work.service (overlap-guarded)

[Service]
Type=oneshot
Environment=HOME=/home/jsy
Environment=PATH=/home/jsy/.local/bin:/home/jsy/.cargo/bin:/home/jsy/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=%h/.local/bin/wm-node should-run vibeloop-tick
ExecStart=/home/jsy/.local/bin/claude-vibeloop-headless.sh
TimeoutStartSec=60
