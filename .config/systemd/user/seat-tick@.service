[Unit]
Description=operator seat %i: one claude -p turn on the seat's session (daemon-shaped)
# a failed turn tells ctl in seconds (seat-event.sh ctl "SEAT-TICK FAILED seat=%i: ..."; ctl's own failure = event log only, no wake)
OnFailure=seat-tick-failed@%i.service

[Service]
Type=oneshot
# exit 5 = lock busy (an event turn holds the seat): a counted skip with its own ALARM line in seat-tick.sh, not a unit failure
SuccessExitStatus=5
WorkingDirectory=%h
Environment=WM_SEAT=%i
Environment=PATH=%h/.local/seat-bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/seat-tick.sh %i
# one turn can run for hours; seat-tick.sh caps claude at 95 % of the seat's timeout_sec (seats.tsv, 14400), so this must stay >= that column
TimeoutStartSec=14400
