[Unit]
Description=fleet-token weekly rotation: move the fleet to the account named in ~/.config/fleet-token/schedule (no-op when it is already current)
ConditionHost=carbon

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/fleet-token-schedule.sh
TimeoutStartSec=1200
