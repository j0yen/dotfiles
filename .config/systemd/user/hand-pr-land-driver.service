[Unit]
Description=hand-pr-land-driver: walk open hand PRs (synthorg/mcphost/wm-build) GATED -> verify -> gate -> rb-merge -> post-merge ring (five-whys 2026-10-24-wo16-3of7 mechanism 1)
# carbon only: the file installs everywhere (install.sh links the whole tree), the unit runs on carbon. Shipped DISABLED: the verifier enables the timer after review.
ConditionHost=carbon

# PREMISE=wm-decide importable (wm_decide.mergegate); rb-merge.sh present; aide-verifier.sh supports --timeout. The script checks it every tick and rings ctl once if it fails.
# EXPIRES=2026-11-08 12:00 (local; HPLD_EXPIRES overrides). Past it every tick rings ctl once ("expired") and does nothing: renew by editing the default in the script via a reviewed PR.

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# fleet token for gh auth (never printed by the script); a missing file is not an error
EnvironmentFile=-%h/.config/environment.d/*.conf
ExecStart=%h/.local/bin/hand-pr-land-driver.sh
# a launch waits on the verifier-cap lock; the script budgets each tick (HPLD_TICK_BUDGET_S 1500) under this ceiling (rb-merge 900 s, launch 600 s)
TimeoutStartSec=1800
