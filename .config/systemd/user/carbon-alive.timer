[Unit]
Description=carbon off-host probe every 2 minutes (redbaron, ryzen7)

[Timer]
# both lines: an empty OnUnitActiveSec= drop-in wipes OnBootSec (10-24 timer blackout trap), so the pair stays together
# no Persistent=: it only applies to OnCalendar= timers (A1446 review F3)
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
