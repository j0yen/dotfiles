[Desktop Entry]
Type=Application
Name=Claude (skip permissions)
Comment=Open alacritty running `claude --dangerously-skip-permissions` on login. Re-fires on i3 restart (dex re-scans autostart).
Exec=env BROWSER= alacritty -e claude --dangerously-skip-permissions
Terminal=false
X-GNOME-Autostart-enabled=true
